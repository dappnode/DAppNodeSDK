{
  "name": "@dappnode/dappnodesdk",
  "version": "0.3.56",
  "type": "module",
  "description": "dappnodesdk is a tool to make the creation of new dappnode packages as simple as possible. It helps to initialize and publish in ethereum blockchain",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": "dist/dappnodesdk.js",
  "scripts": {
    "tag-and-publish": "npm version patch && git push --follow-tags",
    "test": "mocha",
    "lint": "eslint src test --max-warnings 0",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "prepublish": "npm run build",
    "pre-commit": "npm run lint && npm run test",
    "test:integration": "mocha --no-config --import=tsx --require=dotenv/config --timeout 120000 \"test/commands/build.test.ts\" \"test/tasks/generatePublishTx.test.ts\" \"test/utils/versions/getNextPackageVersion.test.ts\"",
    "lint:fix": "npm run lint -- --fix"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dappnode/DAppNodeSDK.git"
  },
  "keywords": [
    "cli",
    "dappnode",
    "ethereum"
  ],
  "author": "DAppNode Association <admin@dappnode.io> (https://github.com/dappnode)",
  "contributors": [
    "Eduardo Antuña <eduadiez@gmail.com> (https://github.com/eduadiez)",
    "dappLion <dapplion@dappnode.io> (https://github.com/dapplion)"
  ],
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/dappnode/DAppNodeSDK/issues"
  },
  "homepage": "https://github.com/dappnode/DAppNodeSDK#readme",
  "dependencies": {
    "@dappnode/schemas": "^0.1.26",
    "@dappnode/types": "^0.1.41",
    "@octokit/rest": "^22.0.1",
    "async-retry": "^1.2.3",
    "chalk": "^2.4.2",
    "cli-progress": "^3.8.2",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "figlet": "^1.2.3",
    "form-data": "^4.0.6",
    "got": "^14.6.6",
    "image-size": "^2.0.4",
    "inquirer": "^12.11.1",
    "js-yaml": "^4.3.2",
    "listr": "^0.14.3",
    "lodash-es": "^4.18.1",
    "log-update": "^6.1.0",
    "mime-types": "^2.1.24",
    "moment": "^2.27.0",
    "prettier": "^2.1.2",
    "semver": "^7.6.0",
    "source-map-support": "^0.5.19",
    "tar-fs": "^3.1.3",
    "timestring": "^5.0.1",
    "wrap-ansi": "^9.0.2",
    "yaml": "^2.8.1",
    "yargs": "^17.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/async-retry": "^1.4.2",
    "@types/chai": "^4.3.4",
    "@types/cli-progress": "^3.7.0",
    "@types/figlet": "^1.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/listr": "^0.14.2",
    "@types/lodash-es": "^4.17.7",
    "@types/mime-types": "^2.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.19.0",
    "@types/prettier": "^2.1.5",
    "@types/semver": "^7.3.1",
    "@types/tar-fs": "^2.0.0",
    "@types/yargs": "^17.0.24",
    "chai": "^5.1.0",
    "eslint": "^10.14.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "resolutions": {
    "minimatch": "^11.0.1",
    "mocha/glob": "^14.0.2"
  }
}
