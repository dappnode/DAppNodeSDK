{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "allowJs": true,
    "strict": true,
    "isolatedModules": true,
    "types": ["mocha", "node"],
    "outDir": "dist",
    "sourceMap": true,
    "declaration": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
